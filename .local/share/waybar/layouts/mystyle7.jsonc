//   --// waybar config: mystyle7 (mystyle6 + gpu, cpu temp, network bandwidth) //--   //
{
    // sourced from header module //
    "position": "top",

    "layer": "top",
    "output": [
        "*"
    ],
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],

    // positions generated based on config.ctl //
    "modules-left": [
        "group/pill#left1",
        "group/pill#left2",
        "group/pill#core"
    ],

    "group/pill#left1": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces"
        ]
    },

    "group/pill#left2": {
        "orientation": "inherit",
        "modules": [
            "custom/hyprsunset",
            "idle_inhibitor",
            "clock"
        ]
    },

    // System vitals cluster: cpu, memory, gpu, temperature
    "group/pill#core": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "memory",
            "custom/gpuinfo#nvidia",
            "temperature"
        ]
    },

    "modules-center": [
        "group/pill#media"
    ],

    "group/pill#media": {
        "orientation": "inherit",
        "modules": [
            "custom/cava",
            "hyprland/window"
        ]
    },

    "modules-right": [
        "group/pill#right1",
        "group/pill#right2",
        "group/pill#right3"
    ],

    "group/pill#right1": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "network#bandwidth",
            "network",
            "pulseaudio",
            "pulseaudio#microphone",
            "custom/updates",
            "custom/weather"
        ]
    },

    "group/pill#right2": {
        "orientation": "inherit",
        "modules": [
            "privacy",
            "tray",
            "battery"
        ]
    },

    "group/pill#right3": {
        "orientation": "inherit",
        "modules": [
            "custom/cliphist",
            "custom/hyde-menu",
            "custom/power"
        ]
    },

    // ─── Module overrides ─────────────────────────────────────────────────
    // Distinguish GPU vs CPU temperature with explicit labels.
    "custom/gpuinfo#nvidia": {
        "format": "GPU {0}"
    },
    "temperature": {
        "format": "CPU {temperatureC}°C"
    },
    // Make bandwidth readable — strip the xx-small spans, use arrows.
    "network#bandwidth": {
        "format-wifi":     "<span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",
        "format-ethernet": "<span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>",
        "format-alt":      "<span foreground='#99ffdd'> {bandwidthDownBytes}</span> <span foreground='#ffcc66'> {bandwidthUpBytes}</span>"
    }
}
