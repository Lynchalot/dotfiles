//   --// waybar config: mystyle8 (mystyle7 + mpris, swaync, wallpaper, systemd-failed-units) //--   //
{
    "position": "top",
    "layer": "top",
    "output": [
        "*"
    ],
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],

    "modules-left": [
        "group/pill#left1",
        "group/pill#left2",
        "group/pill#core"
    ],

    "group/pill#left1": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces"
        ]
    },

    "group/pill#left2": {
        "orientation": "inherit",
        "modules": [
            "custom/hyprsunset",
            "idle_inhibitor",
            "clock",
        ]
    },

    // System vitals: cpu%, cpu temp, memory, gpu temp
    "group/pill#core": {
        "orientation": "inherit",
        "modules": [
            "cpu",
            "temperature",
            "memory",
            "custom/gpuinfo#nvidia"
        ]
    },

    "modules-center": [
        "group/pill#media"
    ],

    "group/pill#media": {
        "orientation": "inherit",
        "modules": [
            "custom/cava",
            "hyprland/window"
        ]
    },

    "modules-right": [
        "group/pill#right1",
        "group/pill#right2",
        "group/pill#right3"
    ],

    "group/pill#right1": {
        "orientation": "inherit",
        "modules": [
            "backlight",
            "network#bandwidth",
            "network",
            "pulseaudio",
            "pulseaudio#microphone",
            "custom/updates",
            "custom/weather"
        ]
    },

    "group/pill#right2": {
        "orientation": "inherit",
        "modules": [
            "tray",
            "privacy",
            "custom/recorder",
            "battery"
        ]
    },

    "group/pill#right3": {
        "orientation": "inherit",
        "modules": [
            "custom/wallchange",
            "custom/swaync",
            "custom/cliphist",
            "custom/hyde-menu",
            "custom/power"
        ]
    },

    // ─── Module overrides ─────────────────────────────────────────────────
    "temperature": {
        "format": "󰔏 {temperatureC}°C"
    },
    "network#bandwidth": {
        "format-wifi":     "<span foreground='#99ffdd'>↓ {bandwidthDownBytes}</span> <span foreground='#ffcc66'>↑ {bandwidthUpBytes}</span>",
        "format-ethernet": "<span foreground='#99ffdd'>↓ {bandwidthDownBytes}</span> <span foreground='#ffcc66'>↑ {bandwidthUpBytes}</span>",
        "format-alt":      "<span foreground='#99ffdd'>↓ {bandwidthDownBytes}</span> <span foreground='#ffcc66'>↑ {bandwidthUpBytes}</span>"
    },
"custom/recorder": {
        "exec": "pgrep -x wf-recorder >/dev/null && echo '<span foreground=\"#f38ba8\"> REC</span>' || echo ''",
        "interval": 2,
        "return-type": "",
        "format": "{}",
        "tooltip": true,
        "tooltip-format": "wf-recorder active — click to stop",
        "on-click": "~/.config/hypr/scripts/screenrecord.sh"
    }
}
