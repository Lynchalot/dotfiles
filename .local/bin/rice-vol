#!/usr/bin/env bash
# rice-vol up|down|mute|mic: what the volume keys run. HyDE's volume control (with its swaync
# volume notification), plus a soft step click when UI sounds are on (rice-sound).
case ${1:-} in
    up)   hyde-shell volumecontrol -o i && rice-sound vol ;;
    down) hyde-shell volumecontrol -o d && rice-sound vol ;;
    mute) hyde-shell volumecontrol -o m ;;
    mic)  hyde-shell volumecontrol -i m ;;
esac
