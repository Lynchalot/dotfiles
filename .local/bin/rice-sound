#!/usr/bin/env bash
# rice-sound: quiet UI sounds on any theme, OFF by default (sounds in ~/.local/share/rice-sounds).
#   rice-sound NAME          play notify|shot|lock|unlock|error|vol|plug|unplug (only while on)
#   rice-sound --from-swaync called by swaync for every notification (picks notify or shot)
#   rice-sound on|off|toggle switch them (HyDE menu > UI Sounds, or Super+Alt+A)
#   rice-sound status        print on / off
# Never plays during Do Not Disturb.
st=${XDG_STATE_HOME:-$HOME/.local/state}/rice-sounds
dir=$HOME/.local/share/rice-sounds

set_on() {
    mkdir -p "$st"
    if [[ $1 == 1 ]]; then
        touch "$st/on"
        notify-send -a "UI sounds" -t 1500 -i audio-volume-high "UI sounds on"
    else
        rm -f "$st/on"
        notify-send -a "UI sounds" -t 1500 -i audio-volume-muted "UI sounds off"
    fi
}

case ${1:-} in
    on) set_on 1; exit 0 ;;
    off) set_on 0; exit 0 ;;
    toggle) [[ -f $st/on ]] && set_on 0 || set_on 1; exit 0 ;;
    status) [[ -f $st/on ]] && echo on || echo off; exit 0 ;;
esac

[[ -f $st/on ]] || exit 0
[[ $(swaync-client -D 2>/dev/null) == true ]] && exit 0

name=${1:-notify}
if [[ $name == --from-swaync ]]; then
    # the "UI sounds on/off" confirmation itself stays silent
    [[ ${SWAYNC_APP_NAME:-} == "UI sounds" ]] && exit 0
    name=notify
    [[ "${SWAYNC_APP_NAME:-} ${SWAYNC_SUMMARY:-}" == *[Ss]creenshot* ]] && name=shot
fi
f=$dir/$name.wav
[[ -f $f ]] || exit 0

# don't stack the same sound when it fires several times at once (held volume key)
stamp=${XDG_RUNTIME_DIR:-/tmp}/rice-sound.$name
now=$(date +%s%N)
last=$(cat "$stamp" 2>/dev/null || echo 0)
((now - last < 90000000)) && exit 0
echo "$now" >"$stamp"
pw-play --volume 0.7 "$f" >/dev/null 2>&1 &
