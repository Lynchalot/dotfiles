#!/usr/bin/env bash
# rice-scratch NAME CLASS-REGEX COMMAND...: an app that drops in and out of its own special workspace
# (adapted from github.com/electrocrem/gits, gits-scratch). Started on first use; if it's already open on a
# normal workspace it's pulled in and given the drop-down shape; after that the key only shows / hides it.
# The window rule (float, size, centre, special workspace) lives in ~/.config/hypr/hyprland.lua.
name=${1:?usage: rice-scratch NAME CLASS-REGEX COMMAND...}
re=${2:?class regex}
shift 2
addr=$(hyprctl clients -j | jq -r --arg re "$re" 'first(.[] | select(.class | test($re))) | .address // empty')
if [[ -z $addr ]]; then
    (($#)) || exit 1
    setsid -f "$@" >/dev/null 2>&1
    # the window rule puts it on special:$name by itself; wait until it exists, then show it
    for _ in {1..40}; do
        hyprctl clients -j | jq -e --arg re "$re" 'any(.[]; .class | test($re))' >/dev/null && break
        sleep 0.25
    done
else
    ws=$(hyprctl clients -j | jq -r --arg a "$addr" '.[] | select(.address == $a) | .workspace.name')
    if [[ $ws != "special:$name" ]]; then
        # opened before the rule could catch it: pull it in and give it the drop-down shape (45% x 75%, centred)
        read -r mw mh < <(hyprctl monitors -j | jq -r 'first(.[] | select(.focused)) | "\((.width / .scale) | floor) \((.height / .scale) | floor)"')
        w="address:$addr"
        hyprctl dispatch "hl.dsp.window.move({ workspace = \"special:$name\", window = \"$w\" })" >/dev/null
        hyprctl dispatch "hl.dsp.window.float({ action = \"enable\", window = \"$w\" })" >/dev/null
        hyprctl dispatch "hl.dsp.window.resize({ x = $((mw * 45 / 100)), y = $((mh * 75 / 100)), window = \"$w\" })" >/dev/null
        hyprctl dispatch "hl.dsp.window.center({ window = \"$w\" })" >/dev/null
    fi
fi
# moving a window onto a special workspace may already show it: only toggle when it isn't shown yet
shown=$(hyprctl monitors -j | jq -r 'first(.[] | select(.focused)) | .specialWorkspace.name')
if [[ -z ${ws:-} || $ws == "special:$name" || $shown != "special:$name" ]]; then
    hyprctl dispatch "hl.dsp.workspace.toggle_special(\"$name\")" >/dev/null
fi
