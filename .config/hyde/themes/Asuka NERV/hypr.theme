$HOME/.config/hypr/themes/theme.conf|> $HOME/.config/hypr/themes/colors.conf
#  // P̳r̳a̳s̳a̳n̳t̳h̳ R̳a̳n̳g̳a̳n̳

$GTK_THEME=Kanagawa-NERV
$ICON_THEME = Tela-circle-dracula-dark
$CURSOR_THEME = Bibata-Modern-Ice
$CURSOR_SIZE = 24
$COLOR_SCHEME = prefer-dark

# Optional: The varibles above will be set automatically when the theme is loaded
# This exec commands will soon be deprecated

exec = gsettings set org.gnome.desktop.interface icon-theme $ICON_THEME
exec = gsettings set org.gnome.desktop.interface gtk-theme $GTK_THEME
exec = gsettings set org.gnome.desktop.interface color-scheme $COLOR_SCHEME
exec = gsettings set org.gnome.desktop.interface cursor-theme $CURSOR_THEME
exec = gsettings set org.gnome.desktop.interface cursor-size $CURSOR_SIZE
exec = hyprctl setcursor $CURSOR_THEME $CURSOR_SIZE
exec = gsettings set org.gnome.desktop.interface font-name "Sarasa UI J Nerd Font 10"

general {
    gaps_in = 3
    gaps_out = 8
    border_size = 2
    col.active_border = rgba(dc6d4cff) rgba(c27a83ff) rgba(7e9cd8ff) rgba(2d4f67ff) 45deg
    col.inactive_border = rgba(25304ecc) rgba(1c2440cc) 45deg
    layout = dwindle
    resize_on_border = true
}

group {
    col.border_active = rgba(dc6d4cff) rgba(c27a83ff) rgba(7e9cd8ff) rgba(2d4f67ff) 45deg
    col.border_inactive = rgba(25304ecc) rgba(1c2440cc) 45deg
    col.border_locked_active = rgba(d27e63ff) rgba(e6c384ff) 45deg
    col.border_locked_inactive = rgba(25304ecc) rgba(1c2440cc) 45deg
}

decoration {
    rounding = 10
    shadow:enabled = false

    blur {
        enabled = yes
        size = 4
        passes = 2
        new_optimizations = on
        ignore_opacity = on
        xray = false
    }
}

layerrule = rounding:10,waybar

# Animated Kanagawa-NERV border on the active window: coral -> rose -> steel -> deep blue
general {
    col.active_border = rgba(dc6d4cff) rgba(c27a83ff) rgba(7e9cd8ff) rgba(2d4f67ff) 45deg
}
animations {
    bezier = liner, 1, 1, 1, 1
    animation = borderangle, 1, 30, liner, loop
}
