//   --// waybar config: mystyle9 (mystyle8 + hover drawers: vitals/tools/power, click menus: volume/power, compact weather) //--   //
{
    "position": "top",
    "layer": "top",
    "output": [
        "*"
    ],
    "height": 10,
    "exclusive": true,
    "passthrough": false,
    "reload_style_on_change": true,
    "include": [
        "$XDG_CONFIG_HOME/waybar/modules/*json*",
        "$XDG_CONFIG_HOME/waybar/includes/includes.json"
    ],
    "modules-left": [
        "group/pill#left1",
        "group/pill#left2",
        "group/pill#core"
    ],
    "group/pill#left1": {
        "orientation": "inherit",
        "modules": [
            "hyprland/workspaces"
        ]
    },
    "group/pill#left2": {
        "orientation": "inherit",
        "modules": [
            "group/clockd"
        ]
    },
    "group/pill#core": {
        "orientation": "inherit",
        "modules": [
            "group/vitals"
        ]
    },
    "group/vitals": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "vitals-drawer",
            "transition-left-to-right": true,
            "click-to-reveal": false
        },
        "modules": [
            "cpu",
            "temperature",
            "memory",
            "custom/gpuinfo#nvidia"
        ]
    },
    "modules-center": [
        "group/pill#media"
    ],
    "group/pill#media": {
        "orientation": "inherit",
        "modules": [
            "hyprland/window"
        ]
    },
    "modules-right": [
        "group/pill#right1",
        "group/pill#right2",
        "group/pill#right3"
    ],
    "group/pill#right1": {
        "orientation": "inherit",
        "modules": [
            "network#bandwidth",
            "network",
            "pulseaudio",
            "group/weatherd"
        ]
    },
    "group/pill#right2": {
        "orientation": "inherit",
        "modules": [
            "tray",
            "privacy",
            "custom/recorder",
            "battery",
            "custom/swaync"
        ]
    },
    "group/pill#right3": {
        "orientation": "inherit",
        "modules": [
            "custom/caffeine-badge",
            "custom/hyprsunset-badge",
            "group/tools",
            "group/power"
        ]
    },
    "group/tools": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "tools-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": [
            "custom/tools",
            "custom/snip",
            "custom/picker",
            "custom/cliphist",
            "custom/rec",
            "custom/wallchange",
            "custom/hyprsunset",
            "custom/caffeine"
        ]
    },
    "group/power": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "power-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": [
            "custom/powerbtn",
            "custom/lock",
            "custom/logout",
            "custom/reboot"
        ]
    },
    "custom/tools": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>widgets</span>",
        "tooltip": true,
        "tooltip-format": "Tools",
        "on-click": "",
        "interval": "once"
    },
    "custom/snip": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>screenshot_region</span>",
        "tooltip": true,
        "tooltip-format": "Screenshot (region)",
        "on-click": "hyde-shell screenshot s",
        "interval": "once"
    },
    "custom/picker": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>colorize</span>",
        "tooltip": true,
        "tooltip-format": "Colour picker (copies hex)",
        "on-click": "hyprpicker -a",
        "interval": "once"
    },
    "custom/rec": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>radio_button_checked</span>",
        "tooltip": true,
        "tooltip-format": "Record screen (click again to stop)",
        "on-click": "~/.config/hypr/scripts/screenrecord.sh",
        "interval": "once"
    },
    "custom/lock": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>lock</span>",
        "tooltip": true,
        "tooltip-format": "Lock",
        "on-click": "hyde-shell lockscreen.sh",
        "interval": "once"
    },
    "custom/logout": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>logout</span>",
        "tooltip": true,
        "tooltip-format": "Log out",
        "on-click": "hyprctl dispatch exit 0",
        "interval": "once"
    },
    "custom/reboot": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>restart_alt</span>",
        "tooltip": true,
        "tooltip-format": "Reboot",
        "on-click": "systemctl reboot",
        "interval": "once"
    },
    "hyprland/workspaces": {
        "format": "{id}"
    },
    "pulseaudio": {
        "menu": "on-click",
        "menu-file": "${HYDE_WAYBAR_MENU_DIR:-$XDG_DATA_HOME/waybar/menus}/volume.xml",
        "menu-actions": {
            "select-output": "hyde-shell volumecontrol -s ''",
            "toggle-mute": "hyde-shell volumecontrol -o m",
            "toggle-mic": "hyde-shell volumecontrol -i m",
            "mixer": "pavucontrol-qt -t 3 || pavucontrol -t 3"
        },
        "format": "{icon} {volume}",
        "format-muted": "<span face='Material Symbols Rounded' font_size='13pt' rise='-3pt'>volume_off</span> muted",
        "format-icons": {
            "headphone": "<span face='Material Symbols Rounded' font_size='13pt' rise='-3pt'>headphones</span>",
            "headset": "<span face='Material Symbols Rounded' font_size='13pt' rise='-3pt'>headset_mic</span>",
            "hands-free": "<span face='Material Symbols Rounded' font_size='13pt' rise='-3pt'>headset_mic</span>",
            "default": [
                "<span face='Material Symbols Rounded' font_size='13pt' rise='-3pt'>volume_up</span>"
            ]
        },
        "on-click": ""
    },
    "custom/weather": {
        "exec": "$HOME/.local/bin/waybar-weather"
    },
    "temperature": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>device_thermostat</span> {temperatureC}°C",
        "format-warning": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt' foreground='#fab387'>device_thermostat</span> <span foreground='#fab387'>{temperatureC}°C</span>",
        "format-critical": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt' foreground='#f38ba8'>device_thermostat</span> <span foreground='#f38ba8'>{temperatureC}°C</span>"
    },
    "network#bandwidth": {
        "format-wifi": "<span foreground='#99ffdd'>↓ {bandwidthDownBytes}</span> <span foreground='#ffcc66'>↑ {bandwidthUpBytes}</span>",
        "format-ethernet": "<span foreground='#99ffdd'>↓ {bandwidthDownBytes}</span> <span foreground='#ffcc66'>↑ {bandwidthUpBytes}</span>",
        "format-alt": "<span foreground='#99ffdd'>↓ {bandwidthDownBytes}</span> <span foreground='#ffcc66'>↑ {bandwidthUpBytes}</span>"
    },
    "custom/recorder": {
        "exec": "pgrep -x wf-recorder >/dev/null && echo \"<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt' foreground='#f38ba8'>radio_button_checked</span> <span foreground='#f38ba8'>REC</span>\" || echo ''",
        "interval": 2,
        "return-type": "",
        "format": "{}",
        "tooltip": true,
        "tooltip-format": "wf-recorder active — click to stop",
        "on-click": "~/.config/hypr/scripts/screenrecord.sh"
    },
    "custom/powerbtn": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>power_settings_new</span>",
        "tooltip-format": "Power  (right-click: logout screen)",
        "menu": "on-click",
        "menu-file": "${HYDE_WAYBAR_MENU_DIR:-$XDG_DATA_HOME/waybar/menus}/power-flat.xml",
        "on-click-right": "hyde-shell logoutlaunch 1",
        "menu-actions": {
            "lock": "hyde-shell lockscreen.sh",
            "logout": "hyprctl dispatch exit 0",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot",
            "reboot-firmware": "systemctl reboot --firmware-setup",
            "shutdown": "systemctl poweroff"
        },
        "tooltip": true,
        "interval": "once"
    },
    "group/weatherd": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "weather-drawer",
            "transition-left-to-right": false,
            "click-to-reveal": false
        },
        "modules": [
            "custom/weather",
            "custom/weather-more"
        ]
    },
    "custom/weather-more": {
        "exec": "$HOME/.local/bin/waybar-weather --brief",
        "return-type": "json",
        "interval": 600,
        "format": "{}",
        "tooltip": true
    },
    "clock": {
        "format": "{:%I:%M %p}",
        "tooltip-format": "<span font_size='10pt' weight='bold'>{:%A %d %B}</span>\n<tt><span font_size='9pt'>{calendar}</span></tt>"
    },
    "cpu": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>memory</span> {usage}%"
    },
    "memory": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>memory_alt</span> {used}GB",
        "format-m": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>memory_alt</span> {used}GB",
        "format-h": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>memory_alt</span> {used}GB",
        "format-c": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>memory_alt</span> {used}GB",
        "format-alt": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>memory_alt</span> {percentage}%"
    },
    "custom/gpuinfo#nvidia": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>bolt</span> {percentage}°C"
    },
    "network": {
        "format-wifi": "{icon}",
        "format-ethernet": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>lan</span>",
        "format-linked": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>lan</span>",
        "format-disconnected": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>signal_wifi_off</span>",
        "format-icons": [
            "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>signal_wifi_0_bar</span>",
            "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>network_wifi_1_bar</span>",
            "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>network_wifi_2_bar</span>",
            "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>network_wifi_3_bar</span>",
            "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>signal_wifi_4_bar</span>"
        ]
    },
    "custom/swaync": {
        "format-icons": {
            "notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "inhibited-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "email-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "chat-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "update-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "music-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "volume-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "network-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "battery-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_unread</span>",
            "warning-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notification_important</span>",
            "error-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt' foreground='#f38ba8'>notification_important</span>",
            "none": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications</span>",
            "inhibited-none": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications</span>",
            "dnd": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_off</span>",
            "dnd-none": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_off</span>",
            "dnd-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_off</span>",
            "dnd-inhibited-notification": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_off</span>",
            "dnd-inhibited-none": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>notifications_off</span>"
        }
    },
    "tray": {
        "icon-size": 15
    },
    "custom/cliphist": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>content_paste</span>"
    },
    "custom/wallchange": {
        "format": "<span face='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>wallpaper</span>"
    },
    "custom/hyprsunset": {
        "format": "{icon}",
        "format-icons": {
            "active": "<span font_desc='Material Symbols Rounded @FILL=1' font_size='11.5pt' rise='-2.5pt'>nights_stay</span>",
            "inactive": "<span font_desc='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>nights_stay</span>",
            "default": "<span font_desc='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>nights_stay</span>"
        },
        "exec": "$HOME/.local/bin/waybar-hyprsunset"
    },
    "group/clockd": {
        "orientation": "inherit",
        "drawer": {
            "transition-duration": 400,
            "children-class": "clock-drawer",
            "transition-left-to-right": true,
            "click-to-reveal": false
        },
        "modules": [
            "clock",
            "clock#date"
        ]
    },
    "clock#date": {
        "format": "{:%a %d %b}",
        "interval": 60,
        "tooltip": true,
        "tooltip-format": "<span font_size='10pt' weight='bold'>{:%A %d %B}</span>\n<tt><span font_size='9pt'>{calendar}</span></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "on-scroll": 1,
            "on-click-right": "mode",
            "format": {
                "months": "<span color='#ffead3'><b>{}</b></span>",
                "weekdays": "<span color='#ffcc66'><b>{}</b></span>",
                "today": "<span color='#ff6699'><b>{}</b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-click-forward": "tz_up",
            "on-click-backward": "tz_down",
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "custom/caffeine": {
        "exec": "$HOME/.local/bin/caffeine status",
        "return-type": "json",
        "interval": 30,
        "signal": 8,
        "format": "{icon}",
        "format-icons": {
            "activated": "<span font_desc='Material Symbols Rounded @FILL=1' font_size='11.5pt' rise='-2.5pt'>coffee</span>",
            "deactivated": "<span font_desc='Material Symbols Rounded' font_size='11.5pt' rise='-2.5pt'>coffee</span>"
        },
        "on-click": "$HOME/.local/bin/caffeine toggle",
        "tooltip": true
    },
    "custom/caffeine-badge": {
        "exec": "$HOME/.local/bin/caffeine status | grep -q '\"activated\"' && echo on || true",
        "interval": 30,
        "signal": 8,
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' font_size='11.5pt' rise='-2.5pt'>coffee</span>",
        "tooltip": true,
        "tooltip-format": "Caffeine is on (no sleep). Click to turn off.",
        "on-click": "$HOME/.local/bin/caffeine off"
    },
    "custom/hyprsunset-badge": {
        "exec": "$HOME/.local/bin/waybar-hyprsunset --badge",
        "interval": "once",
        "signal": 19,
        "format": "<span font_desc='Material Symbols Rounded @FILL=1' font_size='11.5pt' rise='-2.5pt'>nights_stay</span>",
        "tooltip": true,
        "tooltip-format": "Night light is on. Click to turn off.",
        "on-click": "hyde-shell hyprsunset -t -P waybar:19"
    }
}
